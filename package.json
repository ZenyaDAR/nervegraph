{
  "name": "nervegraph",
  "version": "0.3.0",
  "description": "Obsidian Graph View, but for source code — scan a JS/TS, Vue/Svelte/Astro, HTML/CSS, Python, Ruby, Rust, Go, PHP, Java/Kotlin, C/C++ or Shopify Liquid project into a dependency graph and browse it interactively.",
  "type": "module",
  "license": "MIT",
  "author": "Yevhenii Dziza",
  "homepage": "https://github.com/ZenyaDAR/nervegraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenyaDAR/nervegraph.git"
  },
  "bugs": {
    "url": "https://github.com/ZenyaDAR/nervegraph/issues"
  },
  "keywords": [
    "dependency-graph",
    "graph",
    "static-analysis",
    "visualization",
    "code-visualization",
    "codebase",
    "architecture",
    "cli",
    "javascript",
    "typescript",
    "html",
    "css",
    "python",
    "ruby",
    "rust",
    "go",
    "php",
    "java",
    "vue",
    "monorepo",
    "shopify",
    "liquid",
    "theme"
  ],
  "bin": {
    "nerve": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "dist",
    "viewer"
  ],
  "dependencies": {
    "fast-glob": "^3",
    "es-module-lexer": "^1",
    "postcss": "^8",
    "ignore": "^5"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  }
}
